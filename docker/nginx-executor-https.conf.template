# INERT TEMPLATE: include only in a dedicated nginx http {} context after
# independent operator approval and replacement of every __PLACEHOLDER__.
# No certificate, credential, socket permission or service is provisioned here.

# Match the ORIGINAL URI, including any arguments, not nginx's normalized $uri.
# These deliberately case-sensitive regexes admit exactly four wire routes.
map "$request_method:$request_uri" $eh_executor_route {
    default 0;
    "~^POST:/v1/container-pilot/current-observation$" 1;
    "~^POST:/v1/container-pilot/commands$" 1;
    "~^GET:/v1/container-pilot/commands/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" 1;
    "~^POST:/v1/container-pilot/commands/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/reconcile$" 1;
}

upstream eh_private_executor {
    server unix:__EXECUTOR_UDS_PATH__;
}

server {
    listen __STAGING_BIND_IP__:9443 ssl;
    server_name __EXECUTOR_DNS_NAME__;
    ssl_certificate __CERTIFICATE_CHAIN_PATH__;
    ssl_certificate_key __CERTIFICATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    # Actual TCP peer only. Never trust X-Forwarded-For/CF-* as source identity.
    allow __APPROVED_NAS_IP__;
    deny all;
    access_log off;
    server_tokens off;
    client_header_timeout 5s;
    client_body_timeout 2s;
    client_max_body_size 8k;
    client_body_buffer_size 8k;
    large_client_header_buffers 2 8k;
    keepalive_timeout 5s;
    send_timeout 10s;

    location / {
        if ($eh_executor_route = 0) { return 404; }
        if ($http_transfer_encoding != "") { return 400; }
        proxy_pass http://eh_private_executor;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header Connection "";
        # Authorization remains caller-supplied; nginx may itself reject
        # duplicates before proxying. Never configure/inject a bearer here.
        proxy_pass_request_headers on;
        proxy_pass_request_body on;
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 4 4k;
        proxy_busy_buffers_size 8k;
        proxy_max_temp_file_size 0;
        proxy_cache off;
        proxy_store off;
        proxy_redirect off;
        proxy_intercept_errors off;
        proxy_ignore_headers X-Accel-Redirect X-Accel-Buffering;
        proxy_next_upstream off;
        proxy_next_upstream_tries 1;
        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 130s;
        proxy_ignore_client_abort on;
    }
}
