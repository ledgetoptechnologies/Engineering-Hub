# Main release recipe: the caller supplies the reviewed immutable inputs.
# Caller must supply a reviewed immutable Node ref and an independently pinned
# `hub_model` named context containing manifest.json and model/ regular files.
ARG HUB_NODE_IMAGE
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS input-check
ARG HUB_NODE_IMAGE
ARG HUB_MODEL_MANIFEST_SHA256
COPY scripts/verify_hub_build_inputs.py /build/verify_hub_build_inputs.py
COPY --from=hub_model / /opt/hub-model-input/
RUN --network=none python /build/verify_hub_build_inputs.py \
      --node-image "$HUB_NODE_IMAGE" --manifest /opt/hub-model-input/manifest.json \
      --manifest-sha256 "$HUB_MODEL_MANIFEST_SHA256" --model-dir /opt/hub-model-input/model \
    && touch /build/inputs-verified
FROM ${HUB_NODE_IMAGE} AS dashboard
# No Node/npm execution until the separate pinned verifier stage succeeds.
COPY --from=input-check /build/inputs-verified /build/inputs-verified
WORKDIR /ui
COPY hub-ui/package.json hub-ui/package-lock.json ./
RUN npm ci --ignore-scripts
COPY hub-ui/ ./
RUN npm run build

FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS builder
# NumPy initializes its BLAS pool during import, before FastEmbed's ONNX thread
# setting applies. Default to one thread for this bounded, already-threaded app.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/opt/venv OPENBLAS_NUM_THREADS=1
WORKDIR /build
RUN python -m pip install --no-cache-dir uv==0.11.17
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --locked --no-default-groups --no-editable
# Fail closed on missing/incorrect external pins; the verifier checks exact
# files in the copied context, not the caller's mutable original directory.
ARG HUB_NODE_IMAGE
ARG HUB_MODEL_MANIFEST_SHA256
COPY scripts/verify_hub_build_inputs.py /build/verify_hub_build_inputs.py
COPY --from=input-check /opt/hub-model-input/ /opt/hub-model-input/
RUN --network=none python /build/verify_hub_build_inputs.py \
      --node-image "$HUB_NODE_IMAGE" --manifest /opt/hub-model-input/manifest.json \
      --manifest-sha256 "$HUB_MODEL_MANIFEST_SHA256" --model-dir /opt/hub-model-input/model \
    && mkdir -p /opt/fastembed-cache/bge-small-en-v1.5 \
    && cp -a /opt/hub-model-input/model/. /opt/fastembed-cache/bge-small-en-v1.5/ \
    && python /build/verify_hub_build_inputs.py \
      --node-image "$HUB_NODE_IMAGE" --manifest /opt/hub-model-input/manifest.json \
      --manifest-sha256 "$HUB_MODEL_MANIFEST_SHA256" --model-dir /opt/fastembed-cache/bge-small-en-v1.5 \
    && HF_HUB_OFFLINE=1 /opt/venv/bin/python -c "from fastembed import TextEmbedding; model=TextEmbedding(model_name='BAAI/bge-small-en-v1.5', cache_dir='/opt/fastembed-cache', local_files_only=True, providers=['CPUExecutionProvider'], threads=1); list(model.embed(['Engineering Hub semantic model image preparation.']))" \
    && chmod -R a+rX /opt/fastembed-cache

FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:${PATH}" \
    HUB_UI_DIRECTORY=/app/dashboard HUB_DB=/var/lib/hub/hub.sqlite3 OPENBLAS_NUM_THREADS=1
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="Engineering Hub Control" \
      org.opencontainers.image.source="https://github.com/ledgetoptechnologies/Engineering-Hub" \
      org.opencontainers.image.revision="${VCS_REF}"
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/fastembed-cache /opt/fastembed-cache
COPY --from=dashboard /ui/dist /app/dashboard
# ARG is read by Python as data, not interpolated into executable shell text.
# Bake identity into the installed package; runtime VCS_REF cannot override it.
# An unlabelled developer build stays unknown; malformed claimed IDs fail build.
RUN python -c "import importlib.resources as r,json,os,re,sys; ref=os.environ['VCS_REF']; ref == 'unknown' or re.fullmatch('[0-9a-f]{40}',ref) or sys.exit('VCS_REF must be unknown or lowercase 40-character SHA'); r.files('engineering_hub').joinpath('_build_identity.json').write_text(json.dumps({'schema_version':1,'build_commit':None if ref == 'unknown' else ref},separators=(',',':')),encoding='utf-8')"
RUN groupadd --system --gid 568 hub \
    && useradd --system --uid 568 --gid hub --no-create-home hub \
    && mkdir -p /var/lib/hub && chown hub:hub /var/lib/hub && chmod 0700 /var/lib/hub
USER 568:568
EXPOSE 8770
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["python", "-c", "import json,urllib.request; r=urllib.request.build_opener(urllib.request.ProxyHandler({})).open('http://127.0.0.1:8770/health',timeout=3); raise SystemExit(0 if json.load(r).get('ok') is True else 1)"]
ENTRYPOINT ["python", "-m", "engineering_hub", "--host", "0.0.0.0", "--port", "8770"]
