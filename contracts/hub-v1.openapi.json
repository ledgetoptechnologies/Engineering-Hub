  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "answer": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "answer"
        ],
        "title": "Answer"
      },
      "Candidate": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "title": "Commit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "commit"
        ],
        "title": "Candidate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewDecision": {
        "properties": {
          "project": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Project"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 2,
            "title": "Options"
          },
          "protected": {
            "type": "boolean",
            "title": "Protected",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project",
          "title",
          "options"
        ],
        "title": "NewDecision"
      },
      "NewRun": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "task_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Task Id"
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Artifact Digest"
          },
          "target": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "task_id",
          "artifact_digest",
          "target"
        ],
        "title": "NewRun"
      },
      "NewTask": {
        "properties": {
          "project": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Project"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "client_request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project",
          "title",
          "client_request_id"
        ],
        "title": "NewTask"
      },
      "Pause": {
        "properties": {
          "paused": {
            "type": "boolean",
            "title": "Paused"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paused"
        ],
        "title": "Pause"
      },
      "Review": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "title": "Commit"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Verdict"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "commit",
          "verdict"
        ],
        "title": "Review"
      },
      "Revision": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision"
        ],
        "title": "Revision"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
