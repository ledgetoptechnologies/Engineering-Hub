  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "answer": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "answer"
        ],
        "title": "Answer"
      },
      "Candidate": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "title": "Commit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "commit"
        ],
        "title": "Candidate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewDecision": {
        "properties": {
          "project": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Project"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 2,
            "title": "Options"
          },
          "protected": {
            "type": "boolean",
            "title": "Protected",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project",
          "title",
          "options"
        ],
        "title": "NewDecision"
      },
      "NewRun": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "task_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Task Id"
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Artifact Digest"
          },
          "target": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "task_id",
          "artifact_digest",
          "target"
        ],
        "title": "NewRun"
      },
      "NewTask": {
        "properties": {
          "project": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Project"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "client_request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project",
          "title",
          "client_request_id"
        ],
        "title": "NewTask"
      },
      "Pause": {
        "properties": {
          "paused": {
            "type": "boolean",
            "title": "Paused"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paused"
        ],
        "title": "Pause"
      },
      "PublicReachability": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "agent": {
            "type": "string",
            "enum": [
              "codex",
              "hermes",
              "claude"
            ],
            "title": "Agent"
          },
          "status": {
            "type": "string",
            "enum": [
              "unlinked",
              "linked_unverified",
              "reachable",
              "busy_queued",
              "offline",
              "unknown_stale"
            ],
            "title": "Status"
          },
          "reason": {
            "type": "string",
            "enum": [
              "no_exact_binding",
              "no_observer_evidence",
              "observer_unavailable",
              "observer_restarted",
              "binding_generation_mismatch",
              "evidence_expired",
              "evidence_in_future",
              "conflicting_evidence",
              "stream_only",
              "session_ready",
              "session_busy_queue_verified",
              "session_disconnected",
              "session_offline",
              "runtime_readiness_unverified"
            ],
            "title": "Reason"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "state_since": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "State Since"
          },
          "last_evidence_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Evidence At"
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          },
          "advisory_only": {
            "type": "boolean",
            "const": true,
            "title": "Advisory Only",
            "default": true
          },
          "link_state": {
            "type": "string",
            "enum": [
              "linked",
              "unlinked",
              "unknown"
            ],
            "title": "Link State",
            "default": "unknown"
          },
          "transport_state": {
            "type": "string",
            "enum": [
              "attached",
              "disconnected",
              "unverified",
              "unknown"
            ],
            "title": "Transport State",
            "default": "unknown"
          },
          "availability_state": {
            "type": "string",
            "enum": [
              "available",
              "busy",
              "offline",
              "unverified",
              "unknown"
            ],
            "title": "Availability State",
            "default": "unknown"
          },
          "evidence_source": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "connector_observer",
                  "runtime_control",
                  "bus_stream"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Source"
          },
          "evidence_level": {
            "type": "string",
            "enum": [
              "runtime_verified",
              "observed",
              "unverified"
            ],
            "title": "Evidence Level",
            "default": "unverified"
          },
          "snapshot_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Revision"
          },
          "binding_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
