include README.md CONTEXT.md uv.lock Dockerfile compose.yaml compose.truenas.yaml .env.example .dockerignore
recursive-include docker *.sh
include docker/Dockerfile.hub-control
include docker/Dockerfile.hub-validation docker/Dockerfile.hub-validation.dockerignore
include compose.hub-control.yaml
include compose.hub-test.yaml
include docker/hub-test.Dockerfile docker/hub-test-smoke.py docker/hub-test-integration.py
include docker/hub-test-acceptance-v1.json docker/hub-test-integration-results.json docker/hub-test-results.txt
recursive-include hub_executor *.py *.md
recursive-include contracts *.json
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
recursive-include hub-ui *.json *.html *.ts *.tsx *.css *.svg
prune hub-ui/node_modules
prune hub-ui/dist
prune hub-ui/test-results
prune hub-ui/playwright-report
