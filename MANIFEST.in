include README.md CONTEXT.md uv.lock Dockerfile compose.yaml compose.truenas.yaml .env.example .dockerignore
recursive-include docker *.sh
include docker/Dockerfile.hub-control
include compose.hub-control.yaml
recursive-include contracts *.json
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
recursive-include hub-ui *.json *.html *.ts *.tsx *.css *.svg
prune hub-ui/node_modules
prune hub-ui/dist
prune hub-ui/test-results
prune hub-ui/playwright-report
